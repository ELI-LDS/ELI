{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ELI Registry v1/v2",
  "oneOf": [{"$ref": "#/$defs/index"}, {"$ref": "#/$defs/item"}],
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^(_[a-z0-9-]+|[a-z][a-z0-9-]*)$"},
    "kind": {"enum": ["component", "shared", "harness"]},
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "description", "filename", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/kind"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "pattern": "^[_a-z0-9-]+\\.json$"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "license", "reservedKinds", "items"],
      "properties": {
        "schemaVersion": {"enum": [1, 2]},
        "version": {"$ref": "#/$defs/version"},
        "license": {"const": "MIT"},
        "reservedKinds": {"const": ["harness"]},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/descriptor"}}
      }
    },
    "entry": {
      "oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["path", "export"], "properties": {"path": {"type": "string", "minLength": 1}, "export": {"type": "string", "minLength": 1}}}]
    },
    "file": {"oneOf": [{"$ref": "#/$defs/textFile"}, {"$ref": "#/$defs/binaryFile"}]},
    "item": {"oneOf": [{"$ref": "#/$defs/textItem"}, {"$ref": "#/$defs/assetItem"}]},
    "textFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "content": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "binaryFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content", "sha256", "encoding"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "\\.woff2$"},
        "content": {"type": "string", "minLength": 4, "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "encoding": {"const": "base64"}
      }
    },
    "textItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "id", "kind", "name", "description", "entry", "dependencies", "peerDependencies", "files"],
      "properties": {
        "schemaVersion": {"const": 1},
        "version": {"$ref": "#/$defs/version"},
        "id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/kind"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "entry": {"$ref": "#/$defs/entry"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "peerDependencies": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/textFile"}}
      }
    },
    "assetItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "id", "kind", "name", "description", "entry", "dependencies", "peerDependencies", "files"],
      "properties": {
        "schemaVersion": {"const": 2},
        "version": {"$ref": "#/$defs/version"},
        "id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/kind"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "entry": {"$ref": "#/$defs/entry"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "peerDependencies": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
      }
    }
  }
}
