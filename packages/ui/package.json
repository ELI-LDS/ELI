{
  "name": "@eli/ui",
  "version": "0.1.0",
  "description": "ELI React 디자인 컴포넌트 라이브러리",
  "type": "module",
  "license": "UNLICENSED",
  "files": ["dist", "README.md"],
  "exports": {
    "./button": { "types": "./dist/button/index.d.ts", "import": "./dist/button/index.js" },
    "./modal": { "types": "./dist/modal/index.d.ts", "import": "./dist/modal/index.js" },
    "./snackbar": { "types": "./dist/snackbar/index.d.ts", "import": "./dist/snackbar/index.js" },
    "./toggle": { "types": "./dist/toggle/index.d.ts", "import": "./dist/toggle/index.js" }
  },
  "sideEffects": ["**/*.css"],
  "peerDependencies": { "react": "^19.3.0" },
  "scripts": {
    "build": "node ../../scripts/build-ui.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "node -e \"throw new Error('아직 공개 배포를 준비하지 않았어요. 라이선스·scope·공개 API를 먼저 확인해요.')\""
  }
}
