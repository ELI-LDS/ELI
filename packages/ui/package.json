    "./fab": { "types": "./dist/fab/index.d.ts", "import": "./dist/fab/index.js" },
    "./loading": { "types": "./dist/loading/index.d.ts", "import": "./dist/loading/index.js" },
    "./menu": { "types": "./dist/menu/index.d.ts", "import": "./dist/menu/index.js" },
