{
  "name": "@eli/ui",
  "version": "0.1.0",
  "description": "ELI React 디자인 컴포넌트 라이브러리",
  "type": "module",
  "license": "UNLICENSED",
  "files": ["dist", "README.md"],
  "exports": {
    "./alert": { "types": "./dist/alert/index.d.ts", "import": "./dist/alert/index.js" },
    "./badge": { "types": "./dist/badge/index.d.ts", "import": "./dist/badge/index.js" },
    "./button": { "types": "./dist/button/index.d.ts", "import": "./dist/button/index.js" },
    "./checkbox": { "types": "./dist/checkbox/index.d.ts", "import": "./dist/checkbox/index.js" },
    "./chip": { "types": "./dist/chip/index.d.ts", "import": "./dist/chip/index.js" },
    "./divider": { "types": "./dist/divider/index.d.ts", "import": "./dist/divider/index.js" },
    "./menu": { "types": "./dist/menu/index.d.ts", "import": "./dist/menu/index.js" },
    "./modal": { "types": "./dist/modal/index.d.ts", "import": "./dist/modal/index.js" },
    "./select": { "types": "./dist/select/index.d.ts", "import": "./dist/select/index.js" },
    "./segment-control": { "types": "./dist/segment-control/index.d.ts", "import": "./dist/segment-control/index.js" },
    "./snackbar": { "types": "./dist/snackbar/index.d.ts", "import": "./dist/snackbar/index.js" },
    "./text": { "types": "./dist/text/index.d.ts", "import": "./dist/text/index.js" },
    "./toggle": { "types": "./dist/toggle/index.d.ts", "import": "./dist/toggle/index.js" }
  },
  "sideEffects": ["**/*.css"],
  "peerDependencies": { "react": "^19.3.0" },
  "scripts": {
    "build": "node ../../scripts/build-ui.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "node -e \"throw new Error('아직 공개 배포를 준비하지 않았어요. 라이선스·scope·공개 API를 먼저 확인해요.')\""
  }
}
